# BrandGuard AI Frontend Environment Template
#
# LOCAL DEVELOPMENT (Vite dev proxy handles /api/* → localhost:5000):
#   Leave empty or set to '/api'
#   VITE_API_BASE_URL=/api
#
# PRODUCTION ON VERCEL:
#   The vercel.json proxy rule already forwards /api/* to the Render backend.
#   You do NOT need to set this variable on Vercel unless you want to override the proxy.
#   If you do set it, use the full Render backend URL:
#   VITE_API_BASE_URL=https://brandguard-ai-fdfl.onrender.com
#
VITE_API_BASE_URL=/api
