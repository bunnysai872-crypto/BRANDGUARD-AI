# BrandGuard AI Backend Environment Configuration Template

# Flask Environment: 'development', 'production', or 'testing'
FLASK_ENV=production
FLASK_APP=run.py
PORT=5000

# Security Keys (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate-a-secure-random-32-byte-hex-string
JWT_SECRET_KEY=generate-a-secure-random-32-byte-jwt-secret-key

# Database Connection
# Local Development:
# DATABASE_URL=sqlite:///brandguard.db
# Production (Render / Neon / Supabase PostgreSQL):
DATABASE_URL=postgresql://brandguard_user:password@host.render.com:5432/brandguard_db

# Connection Pooling (PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins, or '*' for development:
CORS_ORIGINS=https://brandguard-ai.vercel.app,http://localhost:5173

# Google Gemini AI Integration
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash
