# ==========================================
# BrandGuard AI - Full Stack Environment Configuration
# ==========================================

# -----------------
# Backend Settings
# -----------------
FLASK_ENV=production
PORT=5000
SECRET_KEY=generate-a-strong-random-32-byte-secret-key-here
JWT_SECRET_KEY=generate-a-strong-random-32-byte-jwt-secret-key-here

# Database Configuration
# Local SQLite fallback:
# DATABASE_URL=sqlite:///brandguard.db
# Hosted PostgreSQL (Render / Supabase / Neon):
DATABASE_URL=postgresql://user:password@host.region.render.com:5432/brandguard

# Production CORS Allowed Origins
CORS_ORIGINS=https://brandguard-ai.vercel.app,http://localhost:5173

# Google Gemini AI Key
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.8-flash

# ------------------
# Frontend Settings
# ------------------
# Leave as '/api' for local Vite proxy, or set to Render backend for Vercel deployment:
VITE_API_BASE_URL=https://brandguard-api.onrender.com/api
